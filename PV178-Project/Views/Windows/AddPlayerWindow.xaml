<Window x:Class="PV178_Project.Views.Windows.AddPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding Header}" Height="350" Width="450" Background="#3a4859" ResizeMode="CanMinimize"
        >
    <Grid Width="400" Height="350">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Header}" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                   TextAlignment="Left" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <!-- Text -->
            <TextBlock Grid.Column="0" Grid.Row="0" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Player Name
            </TextBlock>
            <TextBlock Grid.Column="0" Grid.Row="1" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Team
            </TextBlock>

            <TextBlock Grid.Column="0" Grid.Row="2" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Date of Birth
            </TextBlock>
            <!-- Input -->
            <TextBox Grid.Column="1" Grid.Row="0" 
                     x:Name="Name" 
                     Background="White"  
                     Height="40" 
                     Width="230"
                     VerticalContentAlignment="Center" 
                     Text="{Binding Name, Mode=TwoWay}"/>
            <!-- Team selection -->
            <ComboBox Grid.Column="1" Grid.Row="1"
                      x:Name="TeamComboBox"
                      Background="White"
                      Height="40"
                      Width="230"
                      VerticalContentAlignment="Center" 
                      ItemsSource="{Binding Teams}"
                      SelectedItem="{Binding Team, Mode=TwoWay}"/>
            <DatePicker Grid.Column="1" Grid.Row="2" 
                        x:Name="DateFrom" 
                        Background="White"
                
                        Width="230" 
                        Height="40"
                        VerticalContentAlignment="Center" 
                        SelectedDate="{Binding DateOfBirth, Mode=TwoWay}"/>
            <Button Grid.Column="1" Grid.Row="3" 
                    HorizontalAlignment="Center" 
                    Height="40" 
                    Width="230"
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    FontSize="16"
                    Background="Green"
                    Command="{Binding SavePlayerCommand}"
                    >
                Add new Player
            </Button>
        </Grid>
    </Grid>
</Window>