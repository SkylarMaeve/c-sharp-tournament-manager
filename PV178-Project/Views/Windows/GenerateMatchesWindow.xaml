<Window x:Class="PV178_Project.Views.Windows.GenerateMatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PV178_Project.Views.Windows"
        mc:Ignorable="d"
        Title="Generate Matches" Height="250" Width="500">
    <Grid Background="{StaticResource Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>

        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"   Grid.Column="0"  Style="{StaticResource StandardTextBlock}" Text="Actual Teams Count"/>
        <TextBlock Grid.Row="1"   Grid.Column="0"  Style="{StaticResource StandardTextBlock}" Text=" Expected Team Count"/>

        <TextBlock Grid.Row="0"   Grid.Column="1" Style="{StaticResource StandardTextBlock}" Text="{Binding ActualTeamsCount}"/>
        <TextBlock Grid.Row="1"  Grid.Column="1"  Style="{StaticResource StandardTextBlock}"  Text="{Binding ExpectedTeamsCount}"/>
        <TextBlock Grid.Row="2"  Grid.Column="1"  Style="{StaticResource StandardTextBlock}"  Text="Make sure all teams are registered"
                   FontSize="14" FontWeight="SemiBold"
                   />

        <Button Grid.Row="3" Grid.Column="1"  
                Command="{Binding GenerateMatchesCommand}" 
                Background="Red"
                Content="Generate"
                Style="{StaticResource StandardButton}"/>

    </Grid>
</Window>
