<Window x:Class="PV178_Project.Views.Windows.GenerateMatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PV178_Project.Views.Windows"
        mc:Ignorable="d"
        Title="Generate Matches"
        Height="200"
        Width="270"
        Background="{StaticResource Background}"
        ResizeMode="CanMinimize">
    <Grid
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <!-- Labels -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource StandardTextBlock}"
            Text="Teams Registered" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource StandardTextBlock}"
            Text="Teams Needed" />
        <!-- Values -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource StandardTextBlock}"
            Text="{Binding ActualTeamsCount}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource StandardTextBlock}"
            Text="{Binding ExpectedTeamsCount}" />
        <!-- Buttons -->
        <Button
            Content="Generate"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Command="{Binding GenerateMatchesCommand}"
            Style="{StaticResource StandardButton}" />
    </Grid>
</Window>