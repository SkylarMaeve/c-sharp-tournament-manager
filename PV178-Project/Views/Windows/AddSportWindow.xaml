<Window x:Class="PV178_Project.Views.Windows.AddSportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PV178_Project.Views.Windows"
        mc:Ignorable="d"
        Title="Add new Sport" Height="250" Width="450" Background="#3a4859" ResizeMode="CanMinimize">
    <Grid Width="400" Height="250">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Add new Sport" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                   TextAlignment="Left" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <!-- Text -->
            <TextBlock Grid.Column="0" Grid.Row="0" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Sport Name
            </TextBlock>
            <TextBlock Grid.Column="0" Grid.Row="1" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Match Length
            </TextBlock>
            <!-- Input -->
            <TextBox x:Name="TeamName" Background="White" Grid.Column="1" Grid.Row="0" Height="40" Width="230"
                     VerticalContentAlignment="Center" />
            <!-- Group selection -->
            <TextBox x:Name="MatchLength" Background="White" Grid.Column="1" Grid.Row="1" Height="40" Width="230"
            VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" Height="40" Width="230"
                    Foreground="White" FontWeight="SemiBold" FontSize="16"
                    Background="Green">
                Add new Sport
            </Button>
        </Grid>
    </Grid>
</Window>
