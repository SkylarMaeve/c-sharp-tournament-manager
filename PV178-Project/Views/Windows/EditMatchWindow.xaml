<Window x:Class="PV178_Project.Views.Windows.EditMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PV178_Project.Views.Windows"
        mc:Ignorable="d"
        Title="EditMatchWindow" Height="400" Width="450" Background="{StaticResource Background}" ResizeMode="CanMinimize">
    <Grid Width="400" Height="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Edit Match" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                   TextAlignment="Left" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            
            <ComboBox Grid.Column="0" Grid.Row="0" FontWeight="Bold" VerticalAlignment="Center"
                       FontSize="20" Foreground="White" 
                       Width="160"
                       ItemsSource="{Binding Teams}"
                       SelectedItem="{Binding TeamA, Mode=TwoWay}"/>
            <TextBlock Grid.Column="1" Grid.Row="0" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White" Text="vs"/>
            <ComboBox Grid.Column="2" Grid.Row="0" FontWeight="Bold" VerticalAlignment="Center"
                      FontSize="20" Foreground="White" 
                      Width="160"
                      ItemsSource="{Binding Teams}"
                      SelectedItem="{Binding TeamB, Mode=TwoWay}"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <!-- Text -->
            <TextBlock Grid.Column="0" Grid.Row="0" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Name
            </TextBlock>
            <TextBlock Grid.Column="0" Grid.Row="1" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White">
                Date
            </TextBlock>
            <TextBlock Grid.Column="0" Grid.Row="2" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White"
                       Text="{Binding TeamA}"/>
            <TextBlock Grid.Column="0" Grid.Row="3" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="White"
                       Text="{Binding TeamB}"/>
            <!-- Input -->
            <TextBox Background="White" Grid.Column="1" Grid.Row="0" Height="40" Width="230"
                     VerticalContentAlignment="Center" Text="{Binding Name, Mode=TwoWay}"/>
            <DatePicker Background="White" Grid.Column="1" Grid.Row="1" Height="40" Width="230"
                     VerticalContentAlignment="Center"
                     SelectedDate="{Binding StartTime, Mode=TwoWay}"/>
            <!-- Group selection -->
            <TextBox Background="White" Grid.Column="1" Grid.Row="2" Height="40" Width="230"
                     VerticalContentAlignment="Center" Text="{Binding PointsTeamA, Mode=TwoWay}"/>
            <TextBox Background="White" Grid.Column="1" Grid.Row="3" Height="40" Width="230"
                     VerticalContentAlignment="Center" Text="{Binding PointsTeamB, Mode=TwoWay}"/>
            
            <Button Grid.Column="1" Grid.Row="4" HorizontalAlignment="Center" Height="40" Width="230"
                    Foreground="White" FontWeight="SemiBold" FontSize="16"
                    Background="Green"
                    Command="{Binding SaveCommand}">
                Save Changes
            </Button>
        </Grid>
    </Grid>
</Window>
