<Page x:Class="PV178_Project.Views.TournamentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Tournaments Page">
    <Grid Margin="50,50,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="730" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Teams" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                       TextAlignment="Left" />
            <Button x:Name="AddTeamButton" Grid.Column="1" Height="40" Width="70" Foreground="White"
                    FontWeight="SemiBold" FontSize="16"
                    Background="Green" HorizontalAlignment="Left"
                    Command="{Binding EditTournamentCommand}">
                Add
            </Button>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="300" Text="Tournament Name" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="100" Text="Sport" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="100" Text="Start" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="100" Text="End" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="100" Text="Teams" />
            <TextBlock Grid.Column="5" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="100" Text="Groups" />
        </Grid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tournaments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="300"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="100"
                                   Text="{Binding Sport}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="100" Text="{Binding Start}" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="100" Text="{Binding End}" />
                        <TextBlock Grid.Column="4" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="100"
                                   Text="{Binding TeamsCount}" />
                        <TextBlock Grid.Column="5" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="100"
                                   Text="{Binding GroupsCount}" />
                        <Button Grid.Column="6" Width="100" Height="30" Background="Green" Foreground="White"
                                Command="{Binding DataContext.EditTournamentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            Edit
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>