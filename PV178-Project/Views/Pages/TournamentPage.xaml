<Page x:Class="PV178_Project.Views.TournamentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="TournamentPage"
      Width="700"
      HorizontalAlignment="Left"
      Background="{StaticResource Background}">
    <Grid Margin="50,50,0,0" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <!-- Page Header -->
        <TextBlock
            Text="Tournament settings"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Style="{StaticResource StandardHeader}" />
        <!-- Labels -->
        <TextBlock
            Text="Name"
            Grid.Column="0"
            Grid.Row="1"
            Style="{StaticResource StandardTextBlock}" />
        <TextBlock
            Text="Sport"
            Grid.Column="0"
            Grid.Row="2"
            Style="{StaticResource StandardTextBlock}" />
        <TextBlock
            Text="Format"
            Grid.Column="0"
            Grid.Row="3"
            Style="{StaticResource StandardTextBlock}" />
        <TextBlock
            Text="Date"
            Grid.Column="0"
            Grid.Row="4"
            Style="{StaticResource StandardTextBlock}" />
        <TextBlock
            Text="Teams Count"
            Grid.Column="0"
            Grid.Row="5"
            Style="{StaticResource StandardTextBlock}" />
        <TextBlock
            Text="Scoring"
            Grid.Column="0"
            Grid.Row="6"
            Style="{StaticResource StandardTextBlock}" />
        <!-- Input -->
        <TextBox
            Text="{Binding Name, Mode=TwoWay}"
            Grid.Column="1"
            Grid.Row="1"
            Width="400"
            Style="{StaticResource StandardTextBox}" />
        <ComboBox
            Grid.Column="1"
            Grid.Row="2"
            Width="290"
            HorizontalAlignment="Left"
            ItemsSource="{Binding Sports}"
            SelectedItem="{Binding Sport, Mode=TwoWay}"
            Style="{StaticResource StandardComboBox}" />
        <Button
            Content="Add"
            Grid.Column="1"
            Grid.Row="2"
            Width="100"
            HorizontalAlignment="Right"
            Command="{Binding AddSportCommand}"
            Style="{StaticResource StandardButton}" />
        <!-- Format selection -->
        <ComboBox
            Grid.Column="1"
            Grid.Row="3"
            Width="400"
            ItemsSource="{Binding Formats}"
            Text="{Binding Format, Mode=TwoWay}"
            Style="{StaticResource StandardComboBox}" />
        <!-- Dates -->
        <DatePicker
            SelectedDate="{Binding DateFrom, Mode=TwoWay}"
            Grid.Column="1"
            Grid.Row="4"
            Width="195"
            HorizontalAlignment="Left"
            Style="{StaticResource StandardDatePicker}" />
        <DatePicker
            SelectedDate="{Binding DateTo, Mode=TwoWay}"
            Grid.Column="1"
            Grid.Row="4"
            Width="195"
            HorizontalAlignment="Right"
            Style="{StaticResource StandardDatePicker}" />
        <!-- Teams Slider and TextBlock-->
        <Slider 
            x:Name="TeamSlider"
            Grid.Column="1"
            Grid.Row="5"
            Minimum="2" Maximum="16"
            Ticks="2, 4, 8, 16"
            Value="{Binding TeamsCount, Mode=TwoWay}" 
            Style="{StaticResource TeamsSlider}"
            />
        <TextBlock
            Text="{Binding ElementName=TeamSlider, Path=Value}"
            Width="50"
            HorizontalAlignment="Right"
            Grid.Column="1"
            Grid.Row="5"
            Style="{StaticResource StandardTextBlock}" />
        <!-- Scoring settings-->
        <Grid Grid.Column="1" Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="65" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="Win"
                Width="50"
                Grid.Column="0"
                Style="{StaticResource StandardTextBlock}" />
            <TextBox
                Text="{Binding Win, Mode=TwoWay}"
                Grid.Column="1"
                Width="65"
                Style="{StaticResource StandardTextBox}" />
            <TextBlock
                Text="Draw"
                Width="50"
                Grid.Column="2"
                Style="{StaticResource StandardTextBlock}" />
            <TextBox
                Text="{Binding Draw, Mode=TwoWay}"
                Grid.Column="3"
                Width="65"
                Style="{StaticResource StandardTextBox}" />
            <TextBlock
                Text="Loss"
                Width="65"
                Grid.Column="4"
                Style="{StaticResource StandardTextBlock}" />
            <TextBox
                Text="{Binding Loss, Mode=TwoWay}"
                Grid.Column="5"
                Width="65"
                Style="{StaticResource StandardTextBox}" />
        </Grid>
        <Button
            Content="Save Tournament"
            Grid.Row="7"
            Grid.Column="1"
            Width="400"
            IsEnabled="{Binding CanSave}"
            Command="{Binding SaveChangesCommand}"
            Style="{StaticResource StandardButton}" />

    </Grid>

</Page>