<Page x:Class="PV178_Project.Views.TeamsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Teams Page"
      HorizontalAlignment="Left"
      Background="{StaticResource Background}">
    <Grid Margin="50,50,0,0" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Page Header -->
        <TextBlock
            Text="Teams"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Style="{StaticResource StandardHeader}" />
        <Button
            Content="Add Team"
            Grid.Row="0"
            HorizontalAlignment="Right"
            IsEnabled="{Binding CanAddTeam}"
            Command="{Binding EditTeamCommand}"
            Style="{StaticResource StandardButton}" />
        <!-- Columns Header -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" /> <!-- Name -->
                <ColumnDefinition Width="50" /> <!-- Group -->
                <ColumnDefinition Width="50" /> <!-- Wins -->
                <ColumnDefinition Width="50" /> <!-- Draws -->
                <ColumnDefinition Width="50" /> <!-- Losses -->
                <ColumnDefinition Width="50" /> <!-- Points -->
                <ColumnDefinition Width="100" /> <!-- Place -->
                <ColumnDefinition Width="50" /> <!-- Edit -->
                <ColumnDefinition Width="50" /> <!-- Delete -->
                <ColumnDefinition Width="50" /> <!-- Players -->
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Team Name"
                Grid.Column="0"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="G"
                Grid.Column="1"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="W"
                Grid.Column="2"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="D"
                Grid.Column="3"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="L"
                Grid.Column="4"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="P"
                Grid.Column="5"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="Place"
                Grid.Column="6"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="Actions"
                Grid.Column="7"
                Grid.ColumnSpan="3"
                Style="{StaticResource ColumnHeader}" />
        </Grid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Teams}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" /> <!-- Name -->
                            <ColumnDefinition Width="50" /> <!-- Group -->
                            <ColumnDefinition Width="50" /> <!-- Wins -->
                            <ColumnDefinition Width="50" /> <!-- Draws -->
                            <ColumnDefinition Width="50" /> <!-- Losses -->
                            <ColumnDefinition Width="50" /> <!-- Points -->
                            <ColumnDefinition Width="100" /> <!-- Place -->
                            <ColumnDefinition Width="50" /> <!-- Edit -->
                            <ColumnDefinition Width="50" /> <!-- Delete -->
                            <ColumnDefinition Width="50" /> <!-- Players -->
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding Name}"
                            Grid.Column="0"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding GroupName}"
                            Grid.Column="1"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding Wins}"
                            Grid.Column="2"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding Draws}"
                            Grid.Column="3"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding Losses}"
                            Grid.Column="4"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding Points}"
                            Grid.Column="5"
                            Style="{StaticResource StandardTextBlock}" />
                        <TextBlock
                            Text="{Binding Placement}"
                            Grid.Column="6"
                            Style="{StaticResource StandardTextBlock}" />
                        <Button
                            Grid.Column="7"
                            Width="40"
                            Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource StandardButton}">
                            <TextBlock
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Text="&#xE70F;" />
                        </Button>

                        <Button
                            Grid.Column="8"
                            Width="40"
                            Background="{StaticResource DeleteButton}"
                            Command="{Binding DataContext.DeleteTeamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource StandardButton}"
                            >
                            <TextBlock
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Text="&#xE74D;" />
                        </Button>
                        
                        <Button
                            Grid.Column="9"
                            Width="40"
                            Background="{StaticResource SpecialButton}"
                            Command="{Binding DataContext.ShowPlayersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource StandardButton}">
                            <TextBlock
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Text="&#xE77B;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</Page>