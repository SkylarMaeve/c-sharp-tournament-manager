<Page x:Class="PV178_Project.Views.MatchSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="MatchSchedulePage">
    <Grid Margin="50,50,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Match Schedule" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                       TextAlignment="Left" />
            <Button Grid.Column="1" Height="40" Width="180" Foreground="White"
                    FontWeight="SemiBold" FontSize="16"
                    Background="DarkRed" HorizontalAlignment="Left"
                    Command="{Binding GenerateMatchesCommand}">
                Generate Matches
            </Button>
            <Button Grid.Column="2" Height="40" Width="200" Foreground="White"
                    FontWeight="SemiBold" FontSize="16"
                    Background="DarkRed" HorizontalAlignment="Left"
                    Command="{Binding ExportMatchesCommand}">
                Export Matches
            </Button>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="150" Text="Name " />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="250" Text="Team" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="150" Text="Date" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="250" Text="Team" />
        </Grid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Matches}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="150"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="250"
                                   Text="{Binding TeamA}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="50"
                                   Text="{Binding PointsTeamA}" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="150" Text="{Binding StartTime}" />
                        <TextBlock Grid.Column="4" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="50"
                                   Text="{Binding PointsTeamB, Mode=TwoWay}" />
                        <TextBlock Grid.Column="5" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="250" Text="{Binding TeamB}" />
                        <Button Grid.Column="6" Width="100" Height="30" Background="Green" Foreground="White"
                                Command="{Binding DataContext.EditMatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            Edit/Log
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>