<Page x:Class="PV178_Project.Views.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="PlayersPage">
<Grid Margin="50,50,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="730" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Header}" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                       TextAlignment="Left" />
            <Button x:Name="AddTeamButton" Grid.Column="1" Height="40" Width="70" Foreground="White"
                    FontWeight="SemiBold" FontSize="16"
                    Background="Green" HorizontalAlignment="Left"
                    Command="{Binding AddPlayerCommand}">
                Add
            </Button>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="200" Text="Name" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="200" Text="Team Name" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="200" Text="Position" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="22" Background="Gray" Foreground="White"
                       TextAlignment="Center" VerticalAlignment="Center" Height="40" Width="200" Text="Date of Birth/Age" />
        </Grid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Players}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="200"
                                   Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="200"
                                   Text="{Binding Team}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="200" Text="{Binding Position}" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" Width="200" Text="{Binding DateOfBirth}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</Page>