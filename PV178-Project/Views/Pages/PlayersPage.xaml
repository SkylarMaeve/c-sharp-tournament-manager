<Page x:Class="PV178_Project.Views.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="PlayersPage">
    <Grid>
        <Grid VerticalAlignment="Top" Margin="50,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Players" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                       TextAlignment="Left" />

            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Foreground="DarkGreen"
                    Background="Green"
                    Height="40"
                    Width="100"
                    FontSize="16"
                    Content="Add player"
                    ToolTip="Import Tournament" />
        </Grid>
        <DataGrid x:Name="Data"
                  AutoGenerateColumns="False"
                  Margin="50,100,0,0"
                  HorizontalAlignment="Left"
                  MaxHeight="600"
                  MinWidth="800"
                  MaxWidth="800"
                  AlternatingRowBackground="Gray"
                  AlternationCount="2"
                  ItemsSource="{Binding Players}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="200" />
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="200" />
                <DataGridTextColumn Header="Players" Binding="{Binding DateOfBirth}" Width="200" />
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>