<Page x:Class="PV178_Project.Views.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="PlayersPage">
    <Grid Margin="50,50,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="730" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Players" FontSize="28" Height="40" FontWeight="Bold" Foreground="White"
                       TextAlignment="Left" />
            <Button x:Name="AddTeamButton" Grid.Column="1" Height="40" Width="70" Foreground="White"
                    FontWeight="SemiBold" FontSize="16"
                    Background="Green" HorizontalAlignment="Left"
                    Command="{Binding AddPlayerCommand}">
                Add
            </Button>
        </Grid>
        <DataGrid
            Grid.Row="1"
            x:Name="Data"
            ItemsSource="{Binding Players}"
            Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="200" />
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="200" />
                <DataGridTextColumn Header="Players" Binding="{Binding DateOfBirth}" Width="200" />
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>