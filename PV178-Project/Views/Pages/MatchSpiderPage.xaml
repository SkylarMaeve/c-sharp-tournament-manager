<Page x:Class="PV178_Project.Views.Pages.MatchSpiderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PV178_Project.Views.Pages"
      mc:Ignorable="d"
      Title="MatchSpiderPage">
    <Page.Resources>
        <DataTemplate x:Key="MatchTemplate">
            <Grid Margin="0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <!-- Actual Match Block-->
                <!-- Top -->
                <TextBlock
                    Grid.ColumnSpan="2"
                    Grid.Row="0"
                    Text="{Binding Name}"
                    FontWeight="Normal"
                    Style="{StaticResource MatchSpider}" />
                <!-- Mid -->
                <TextBlock
                    Grid.Column="0"
                    Grid.Row="1"
                    Text="{Binding TeamA}"
                    Style="{StaticResource MatchSpider}" />
                <TextBlock
                    Grid.Column="1"
                    Grid.Row="1"
                    Text="{Binding PointsTeamA}"
                    Style="{StaticResource MatchSpider}" />
                <!-- Bottom -->
                <TextBlock
                    Grid.Column="0"
                    Grid.Row="2"
                    Text="{Binding TeamB}"
                    Style="{StaticResource MatchSpider}" />
                <TextBlock
                    Grid.Column="1"
                    Grid.Row="2"
                    Text="{Binding PointsTeamB}"
                    Style="{StaticResource MatchSpider}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="50,50,0,0" Width="1050" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Match Spider"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Style="{StaticResource StandardHeader}" />
        <Button
            Content="Export spider"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Command="{Binding ExportSpiderCommand}"
            Background="{StaticResource SpecialButton}"
            Style="{StaticResource StandardButton}" />
        <!-- Columns-->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Grid.Row="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <ItemsControl
                    Grid.Column="0"
                    ItemsSource="{Binding MatchesR16A}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="1"
                    ItemsSource="{Binding MatchesQfA}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="2"
                    ItemsSource="{Binding MatchesSfA}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="3"
                    ItemsSource="{Binding MatchesFinal}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="4"
                    ItemsSource="{Binding MatchesSfB}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="5"
                    ItemsSource="{Binding MatchesQfB}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
                <ItemsControl
                    Grid.Column="6"
                    ItemsSource="{Binding MatchesR16B}"
                    ItemTemplate="{StaticResource MatchTemplate}"
                    VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>