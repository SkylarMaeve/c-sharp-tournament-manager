<Page x:Class="PV178_Project.Views.Pages.SportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PV178_Project.Views.Pages"
      mc:Ignorable="d"
      Title="SportsPage"
      HorizontalAlignment="Left"
      Background="{StaticResource Background}">
    <Grid Margin="50,50,0,0" HorizontalAlignment="Left" Width="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Page Header -->
        <TextBlock
            Text="Sports"
            Grid.Row="0"
            HorizontalAlignment="Left"
            Style="{StaticResource StandardHeader}" />
        <Button
            Content="Add Sport"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Command="{Binding EditSportCommand}"
            Style="{StaticResource StandardButton}" />
        <!-- Columns Header -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" /> <!-- Name -->
                <ColumnDefinition Width="200" /> <!-- GameLength -->
                <ColumnDefinition Width="50" /> <!-- Edit -->
                <ColumnDefinition Width="50" /> <!-- Delete -->
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="Sport Name"
                Grid.Column="0"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="Match Length"
                Grid.Column="1"
                Style="{StaticResource ColumnHeader}" />
            <TextBlock
                Text="Actions"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Style="{StaticResource ColumnHeader}" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /> <!-- Name -->
                                <ColumnDefinition Width="200" /> <!-- GameLength -->
                                <ColumnDefinition Width="50" /> <!-- Edit -->
                                <ColumnDefinition Width="50" /> <!-- Delete -->
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Name}"
                                Grid.Column="0"
                                Style="{StaticResource StandardTextBlock}" />
                            <TextBlock
                                Text="{Binding MatchLength}"
                                Grid.Column="1"
                                Style="{StaticResource StandardTextBlock}" />
                            <Button
                                Grid.Column="2"
                                Width="40"
                                HorizontalAlignment="Right"
                                Command="{Binding DataContext.EditSportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource StandardButton}">
                                <TextBlock
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Text="&#xE70F;" />
                            </Button>

                            <Button
                                Grid.Column="3"
                                Width="40"
                                Background="{StaticResource DeleteButton}"
                                HorizontalAlignment="Right"
                                Command="{Binding DataContext.DeleteSportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource StandardButton}">
                                <TextBlock
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>