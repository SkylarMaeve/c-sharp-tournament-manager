<Window x:Class="PV178_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PV178_Project"
        xmlns:viewModels="clr-namespace:PV178_Project.ViewModels"
        mc:Ignorable="d"
        Title="Tournament Manager" MinHeight="600" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Background="{StaticResource Sidebar}" x:Name="Sidebar" >
            <!-- Tournament Selector -->
            <Grid Margin="15,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          DisplayMemberPath="Name" 
                          FontWeight="Bold"
                          Height="40" Width="150" 
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding Tournaments}"
                          SelectedItem="{Binding SelectedTournament, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Height="40"
                        Width="40"
                        Foreground="DarkGreen"
                        Background="Green"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        Command="{Binding AddTournamentCommand}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xF8AA;" />
                </Button>
            </Grid>

            <!-- Navigation -->
            <Button Content="Tournaments"
                    IsEnabled="True"
                    Command="{Binding TournamentsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Sports"
                    IsEnabled="True"
                    Command="{Binding SportsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Tournament settings"
                    Command="{Binding SettingsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Match Schedule"
                    Command="{Binding MatchScheduleCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Match Spider"
                    Command="{Binding MatchScheduleCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Teams" 
                    Command="{Binding TeamsCommand}"
                    Style="{DynamicResource NavigationButton}" />
            <Button Content="Players" 
                    Command="{Binding PlayersCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Delete Tournament" 
                    Command="{Binding PlayersCommand}"
                    Background="Red" Foreground="DarkRed"
                    Style="{StaticResource NavigationButton}"/>
        </StackPanel>
        <!-- Main Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="{StaticResource Background}" />
    </Grid>
</Window>