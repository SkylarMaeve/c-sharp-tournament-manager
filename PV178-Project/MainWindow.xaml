<Window x:Class="PV178_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PV178_Project"
        xmlns:viewModels="clr-namespace:PV178_Project.ViewModels"
        mc:Ignorable="d"
        Title="Tournament Manager" MinHeight="600" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Background="{StaticResource Sidebar}" x:Name="Sidebar">
            <!-- Tournament Selector -->
            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          DisplayMemberPath="Name" 
                          FontWeight="Bold"
                          Height="40" Width="140" 
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Tournaments}"
                          SelectedItem="{Binding SelectedTournament, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Height="40"
                        Width="40"
                        Foreground="DarkGreen"
                        Background="Green"
                        FontSize="16"
                        Command="{Binding AddTournamentCommand}">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xF8AA;" />
                </Button>
            </Grid>

            <!-- Navigation -->
            <Button Content="Tournament settings"
                    Command="{Binding SettingsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="GamePlan"
                    Command="{Binding GamePlanCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Teams" 
                    Command="{Binding TeamsCommand}"
                    Style="{DynamicResource NavigationButton}" />
            <Button Content="Players" 
                    Command="{Binding PlayersCommand}"
                    Style="{StaticResource NavigationButton}" />

            <!-- Bottom Import/Export/Delete -->
            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        HorizontalAlignment="Center"
                        Foreground="DarkGreen"
                        Background="Green"
                        Height="40"
                        Width="40"
                        FontSize="16"
                        ToolTip="Import Tournament">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE898;" />
                </Button>
                <Button Grid.Column="1"
                        HorizontalAlignment="Center"
                        Height="40"
                        Width="40"
                        Foreground="DimGray"
                        Background="Gray"
                        FontSize="16"
                        ToolTip="Export Tournament">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE896;" />
                </Button>
                <Button Grid.Column="2"
                        HorizontalAlignment="Center"
                        Foreground="DarkRed"
                        Background="Red"
                        Height="40"
                        Width="40"
                        ToolTip="Delete Tournament"
                        IsEnabled="{Binding IsButtonEnabled}">
                    <TextBlock FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE74D;" />
                </Button>

            </Grid>
        </StackPanel>
        <!-- Main Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#3a4859" />
    </Grid>
</Window>