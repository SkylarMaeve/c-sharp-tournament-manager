<Window x:Class="PV178_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PV178_Project"
        xmlns:viewModels="clr-namespace:PV178_Project.ViewModels"
        mc:Ignorable="d"
        Title="Tournament Manager" MinHeight="600" MinWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="{StaticResource Sidebar}">
            <!-- Tournament Selector -->
            <Grid Margin="25,25" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Tournaments}"
                    SelectedItem="{Binding SelectedTournament, Mode=TwoWay}"
                    Style="{StaticResource StandardComboBox}" />
                <Button
                    Grid.Column="1"
                    Width="40"
                    HorizontalAlignment="Right"
                    Command="{Binding AddTournamentCommand}"
                    Style="{StaticResource StandardButton}">
                    <TextBlock
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xF8AA;" />
                </Button>
            </Grid>
            <!-- Navigation -->
            <Button Content="Tournaments"
                    IsEnabled="True"
                    Command="{Binding TournamentsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Sports"
                    IsEnabled="True"
                    Command="{Binding SportsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Tournament settings"
                    Command="{Binding SettingsCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Match Schedule"
                    Command="{Binding MatchScheduleCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Match Spider"
                    Command="{Binding MatchSpiderCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Teams"
                    Command="{Binding TeamsCommand}"
                    Style="{DynamicResource NavigationButton}" />
            <Button Content="Players"
                    Command="{Binding PlayersCommand}"
                    Style="{StaticResource NavigationButton}" />
            <Button Content="Delete Tournament"
                    Command="{Binding DeleteTournamentCommand}"
                    Background="{StaticResource DeleteButton}"
                    Style="{StaticResource NavigationButton}" />
        </StackPanel>
        <!-- Main Frame -->
        <Frame
            Grid.Column="1"
            x:Name="MainFrame"
            Background="{StaticResource Background}" />
    </Grid>
</Window>